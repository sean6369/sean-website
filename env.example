# Environment Variables Example
# Copy this file to .env.local and fill in the values:
#   cp env.example .env.local
#
# .env.local is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# EmailJS — required for the contact form
# Get these from https://dashboard.emailjs.com/
#
# These are NEXT_PUBLIC_ on purpose: EmailJS is a browser-side service and its
# public key is meant to be exposed. Lock the service down with domain
# restrictions in the EmailJS dashboard rather than by hiding the key.
#
# Two separate templates are used. The HTML for each lives in src/templates/
# and needs to be pasted into the matching EmailJS template.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
# Sends the submission to Sean — src/templates/notification-email-template.html
NEXT_PUBLIC_EMAILJS_NOTIFICATION_TEMPLATE_ID=your_notification_template_id_here
# Auto-reply back to the visitor — src/templates/confirmation-email-template.html
NEXT_PUBLIC_EMAILJS_CONFIRMATION_TEMPLATE_ID=your_confirmation_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# ---------------------------------------------------------------------------
# Notion — required for /blog
# Without these the site still builds, but the blog renders "No blog posts yet."
#
# Server-only: do NOT add a NEXT_PUBLIC_ prefix. NOTION_API_KEY is a secret, and
# prefixing it would inline it into the client bundle for anyone to read.
#
# 1. Create an integration at https://www.notion.so/my-integrations and copy its
#    Internal Integration Secret into NOTION_API_KEY.
# 2. Open the blog database in Notion, then Share -> connect your integration.
#    Skipping this makes every query fail.
# 3. NOTION_DATABASE_ID is the 32-char id in the database URL:
#    https://notion.so/<workspace>/<DATABASE_ID>?v=...
#
# The database needs these properties, or queries fail and the blog is silently
# empty (src/lib/notion.ts filters on Published and sorts by Date):
#   Title / Name  title         post title
#   Slug          rich_text     URL segment -> /blog/<slug>
#   Excerpt       rich_text     summary shown in the list and in metadata
#   Published     checkbox      only checked posts are fetched
#   Date          date          sort key, newest first
#   Tags          multi_select  optional
#   Read Time     number        optional, renders as "N minute read"
# ---------------------------------------------------------------------------
NOTION_API_KEY=your_notion_integration_secret_here
NOTION_DATABASE_ID=your_notion_database_id_here

# ---------------------------------------------------------------------------
# Site URL — optional
# Absolute base for Open Graph / Twitter card images and the logo embedded in
# contact-form emails. These cannot be relative, since they are resolved outside
# the page. Defaults to the production deployment (see src/lib/site.ts), so set
# this only for a custom domain, a preview deploy, or a local tunnel.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://sean-website.vercel.app

# ---------------------------------------------------------------------------
# Not read by any code today — placeholder only.
# The contact recipient and social links are hardcoded in the components.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
